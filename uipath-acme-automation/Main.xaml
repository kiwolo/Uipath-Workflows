<?xml version="1.0" encoding="utf-8"?>
<Activity
  mc:Ignorable="sap sap2010 sads"
  x:Class="Main"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
  xmlns:uc="clr-namespace:UiPath.Core;assembly=UiPath.System.Activities"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <VisualBasic.Settings>
    <x:Null />
  </VisualBasic.Settings>

  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>

  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>

  <StateMachine x:Name="REFramework_StateMachine" DisplayName="ACME Employee Data Extraction">

    <StateMachine.Variables>
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)"
                Name="Config" Default="[New Dictionary(Of String, String)()]" />
      <Variable x:TypeArguments="x:Int32"   Name="intSystemExceptionRetries" Default="0" />
      <Variable x:TypeArguments="x:Int32"   Name="intTransactionNumber"       Default="0" />
      <Variable x:TypeArguments="x:Boolean" Name="blnInitSuccessful"          Default="False" />
      <Variable x:TypeArguments="x:String"  Name="strTransactionID"           Default="&quot;&quot;" />
      <Variable x:TypeArguments="s:Exception" Name="BusinessException" />
      <Variable x:TypeArguments="s:Exception" Name="SystemException" />
    </StateMachine.Variables>

    <StateMachine.InitialState>
      <x:Reference>InitializationState</x:Reference>
    </StateMachine.InitialState>

    <!-- STATE 1: INITIALIZATION -->
    <State x:Name="InitializationState" DisplayName="Initialization">
      <State.Entry>
        <Sequence DisplayName="Initialization Entry">
          <ui:LogMessage Level="Info"
                         Message="[&quot;[INIT] Starting ACME Employee Data Extraction process&quot;]" />
          <TryCatch DisplayName="Initialize Settings and Applications">
            <TryCatch.Try>
              <Sequence>
                <ui:InvokeWorkflowFile DisplayName="InitAllSettings"
                                       WorkflowFileName="Framework\InitAllSettings.xaml">
                  <ui:InvokeWorkflowFile.Arguments>
                    <x:Dictionary x:TypeArguments="x:String, x:Object">
                      <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="out_Config">[Config]</OutArgument>
                    </x:Dictionary>
                  </ui:InvokeWorkflowFile.Arguments>
                </ui:InvokeWorkflowFile>
                <ui:InvokeWorkflowFile DisplayName="InitAllApplications"
                                       WorkflowFileName="Framework\InitAllApplications.xaml">
                  <ui:InvokeWorkflowFile.Arguments>
                    <x:Dictionary x:TypeArguments="x:String, x:Object">
                      <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="in_Config">[Config]</InArgument>
                    </x:Dictionary>
                  </ui:InvokeWorkflowFile.Arguments>
                </ui:InvokeWorkflowFile>
                <Assign DisplayName="Mark Init Successful">
                  <Assign.To><OutArgument x:TypeArguments="x:Boolean">[blnInitSuccessful]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
                </Assign>
                <ui:LogMessage Level="Info"
                               Message="[&quot;[INIT] Initialization completed successfully&quot;]" />
              </Sequence>
            </TryCatch.Try>
            <TryCatch.Catches>
              <Catch x:TypeArguments="s:Exception">
                <ActivityAction x:TypeArguments="s:Exception">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="s:Exception" Name="initException" />
                  </ActivityAction.Argument>
                  <Sequence>
                    <ui:LogMessage Level="Error"
                                   Message="[&quot;[INIT] Initialization failed: &quot; &amp; initException.Message]" />
                    <Assign>
                      <Assign.To><OutArgument x:TypeArguments="x:Boolean">[blnInitSuccessful]</OutArgument></Assign.To>
                      <Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value>
                    </Assign>
                    <Throw Exception="[initException]" />
                  </Sequence>
                </ActivityAction>
              </Catch>
            </TryCatch.Catches>
          </TryCatch>
        </Sequence>
      </State.Entry>

      <State.Transitions>
        <Transition DisplayName="Init Success" To="GetTransactionDataState">
          <Transition.Condition>[blnInitSuccessful = True]</Transition.Condition>
        </Transition>
        <Transition DisplayName="Init Failed" To="EndProcessState">
          <Transition.Condition>[blnInitSuccessful = False]</Transition.Condition>
        </Transition>
      </State.Transitions>
    </State>

    <!-- STATE 2: GET TRANSACTION DATA -->
    <State x:Name="GetTransactionDataState" DisplayName="GetTransactionData">
      <State.Variables>
        <Variable x:TypeArguments="x:Boolean" Name="blnMoreTransactions" Default="False" />
      </State.Variables>
      <State.Entry>
        <Sequence DisplayName="Get Transaction Data Entry">
          <TryCatch DisplayName="Try - GetTransactionData">
            <TryCatch.Try>
              <ui:InvokeWorkflowFile DisplayName="GetTransactionData"
                                     WorkflowFileName="Framework\GetTransactionData.xaml">
                <ui:InvokeWorkflowFile.Arguments>
                  <x:Dictionary x:TypeArguments="x:String, x:Object">
                    <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="in_Config">[Config]</InArgument>
                    <InArgument x:TypeArguments="x:Int32" x:Key="in_TransactionNumber">[intTransactionNumber]</InArgument>
                    <OutArgument x:TypeArguments="x:Boolean" x:Key="out_MoreTransactions">[blnMoreTransactions]</OutArgument>
                    <OutArgument x:TypeArguments="x:String" x:Key="out_TransactionID">[strTransactionID]</OutArgument>
                  </x:Dictionary>
                </ui:InvokeWorkflowFile.Arguments>
              </ui:InvokeWorkflowFile>
            </TryCatch.Try>
            <TryCatch.Catches>
              <Catch x:TypeArguments="s:Exception">
                <ActivityAction x:TypeArguments="s:Exception">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="s:Exception" Name="getDataException" />
                  </ActivityAction.Argument>
                  <Sequence>
                    <ui:LogMessage Level="Error"
                                   Message="[&quot;[GET_DATA] Failed to retrieve transaction data: &quot; &amp; getDataException.Message]" />
                    <Assign>
                      <Assign.To><OutArgument x:TypeArguments="x:Boolean">[blnMoreTransactions]</OutArgument></Assign.To>
                      <Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value>
                    </Assign>
                  </Sequence>
                </ActivityAction>
              </Catch>
            </TryCatch.Catches>
          </TryCatch>
        </Sequence>
      </State.Entry>

      <State.Transitions>
        <Transition DisplayName="Process Transaction" To="ProcessState">
          <Transition.Condition>[blnMoreTransactions = True]</Transition.Condition>
        </Transition>
        <Transition DisplayName="No More Transactions" To="EndProcessState">
          <Transition.Condition>[blnMoreTransactions = False]</Transition.Condition>
        </Transition>
      </State.Transitions>
    </State>

    <!-- STATE 3: PROCESS TRANSACTION -->
    <State x:Name="ProcessState" DisplayName="Process">
      <State.Variables>
        <Variable x:TypeArguments="x:Boolean" Name="blnProcessSuccess" Default="False" />
      </State.Variables>
      <State.Entry>
        <Sequence DisplayName="Process Transaction Entry">
          <Assign DisplayName="Increment Transaction Number">
            <Assign.To><OutArgument x:TypeArguments="x:Int32">[intTransactionNumber]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:Int32">[intTransactionNumber + 1]</InArgument></Assign.Value>
          </Assign>
          <ui:LogMessage Level="Info"
                         Message="[&quot;[PROCESS] Processing transaction #&quot; &amp; intTransactionNumber.ToString()]" />
          <TryCatch DisplayName="Try - Process">
            <TryCatch.Try>
              <ui:InvokeWorkflowFile DisplayName="Process"
                                     WorkflowFileName="Framework\Process.xaml">
                <ui:InvokeWorkflowFile.Arguments>
                  <x:Dictionary x:TypeArguments="x:String, x:Object">
                    <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="in_Config">[Config]</InArgument>
                    <InArgument x:TypeArguments="x:Int32" x:Key="in_TransactionNumber">[intTransactionNumber]</InArgument>
                    <InArgument x:TypeArguments="x:String" x:Key="in_TransactionID">[strTransactionID]</InArgument>
                    <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Success">[blnProcessSuccess]</OutArgument>
                  </x:Dictionary>
                </ui:InvokeWorkflowFile.Arguments>
              </ui:InvokeWorkflowFile>
            </TryCatch.Try>
            <TryCatch.Catches>
              <Catch x:TypeArguments="uc:BusinessRuleException">
                <ActivityAction x:TypeArguments="uc:BusinessRuleException">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="uc:BusinessRuleException" Name="bizException" />
                  </ActivityAction.Argument>
                  <Sequence>
                    <ui:LogMessage Level="Warn"
                                   Message="[&quot;[PROCESS] Business rule exception on transaction #&quot; &amp; intTransactionNumber.ToString() &amp; &quot;: &quot; &amp; bizException.Message]" />
                    <Assign>
                      <Assign.To><OutArgument x:TypeArguments="x:Boolean">[blnProcessSuccess]</OutArgument></Assign.To>
                      <Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value>
                    </Assign>
                  </Sequence>
                </ActivityAction>
              </Catch>
              <Catch x:TypeArguments="s:Exception">
                <ActivityAction x:TypeArguments="s:Exception">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="s:Exception" Name="sysException" />
                  </ActivityAction.Argument>
                  <Sequence>
                    <ui:LogMessage Level="Error"
                                   Message="[&quot;[PROCESS] System exception on transaction #&quot; &amp; intTransactionNumber.ToString() &amp; &quot; (retry &quot; &amp; intSystemExceptionRetries.ToString() &amp; &quot;): &quot; &amp; sysException.Message]" />
                    <Assign>
                      <Assign.To><OutArgument x:TypeArguments="x:Int32">[intSystemExceptionRetries]</OutArgument></Assign.To>
                      <Assign.Value><InArgument x:TypeArguments="x:Int32">[intSystemExceptionRetries + 1]</InArgument></Assign.Value>
                    </Assign>
                    <Assign>
                      <Assign.To><OutArgument x:TypeArguments="x:Boolean">[blnProcessSuccess]</OutArgument></Assign.To>
                      <Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value>
                    </Assign>
                  </Sequence>
                </ActivityAction>
              </Catch>
            </TryCatch.Catches>
          </TryCatch>
        </Sequence>
      </State.Entry>

      <State.Transitions>
        <Transition DisplayName="Process Success - Next Transaction" To="GetTransactionDataState">
          <Transition.Condition>[blnProcessSuccess = True]</Transition.Condition>
        </Transition>
        <Transition DisplayName="Retry After System Exception" To="InitializationState">
          <Transition.Condition>[blnProcessSuccess = False AndAlso intSystemExceptionRetries &lt; CInt(If(Config.ContainsKey("MaxRetries"), Config("MaxRetries"), "3"))]</Transition.Condition>
        </Transition>
        <Transition DisplayName="End After Failure" To="EndProcessState">
          <Transition.Condition>[blnProcessSuccess = False AndAlso intSystemExceptionRetries &gt;= CInt(If(Config.ContainsKey("MaxRetries"), Config("MaxRetries"), "3"))]</Transition.Condition>
        </Transition>
      </State.Transitions>
    </State>

    <!-- STATE 4: END PROCESS (FINAL) -->
    <State x:Name="EndProcessState" DisplayName="EndProcess" IsFinal="True">
      <State.Entry>
        <ui:InvokeWorkflowFile DisplayName="EndProcess"
                               WorkflowFileName="Framework\EndProcess.xaml">
          <ui:InvokeWorkflowFile.Arguments>
            <x:Dictionary x:TypeArguments="x:String, x:Object">
              <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="in_Config">[Config]</InArgument>
              <InArgument x:TypeArguments="x:Int32" x:Key="in_TransactionNumber">[intTransactionNumber]</InArgument>
            </x:Dictionary>
          </ui:InvokeWorkflowFile.Arguments>
        </ui:InvokeWorkflowFile>
      </State.Entry>
    </State>

  </StateMachine>
</Activity>
