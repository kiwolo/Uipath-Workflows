<?xml version="1.0" encoding="utf-8"?>
<Activity
  x:Class="Framework_Process"
  mc:Ignorable="sap sap2010 sads"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:sdt="clr-namespace:System.Data;assembly=System.Data.Common"
  xmlns:sio="clr-namespace:System.IO;assembly=System.Private.CoreLib"
  xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
  xmlns:uc="clr-namespace:UiPath.Core;assembly=UiPath.System.Activities"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:uia="http://schemas.uipath.com/workflow/activities/uiautomation"
  xmlns:excel="clr-namespace:UiPath.Excel.Activities;assembly=UiPath.Excel.Activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:Members>
    <x:Property Name="in_Config"            Type="InArgument(scg:Dictionary(x:String, x:String))" />
    <x:Property Name="in_TransactionNumber" Type="InArgument(x:Int32)" />
    <x:Property Name="in_TransactionID"     Type="InArgument(x:String)" />
    <x:Property Name="out_Success"          Type="OutArgument(x:Boolean)" />
  </x:Members>

  <VisualBasic.Settings>
    <x:Null />
  </VisualBasic.Settings>

  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>

  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
      <AssemblyReference>UiPath.UIAutomation.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>

  <Sequence DisplayName="Process - Employee Data Extraction">
    <Sequence.Variables>
      <Variable x:TypeArguments="sdt:DataTable" Name="dtEmployeeData" />
      <Variable x:TypeArguments="x:Int32"  Name="intTimeout"    Default="30000" />
      <Variable x:TypeArguments="x:String" Name="strOutputPath" Default="&quot;&quot;" />
    </Sequence.Variables>

    <!-- Set runtime config values -->
    <Assign DisplayName="Set Timeout">
      <Assign.To><OutArgument x:TypeArguments="x:Int32">[intTimeout]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Int32">[CInt(in_Config("TimeoutMS"))]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Build Output File Path">
      <Assign.To><OutArgument x:TypeArguments="x:String">[strOutputPath]</OutArgument></Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          [Path.Combine(in_Config("OutputFolderPath"), in_Config("OutputFileName"))]
        </InArgument>
      </Assign.Value>
    </Assign>

    <ui:LogMessage Level="Info"
                   Message="[&quot;[PROCESS] Starting employee data extraction. Transaction: &quot; &amp; in_TransactionID]" />

    <!-- STEP 1: Ensure output folder exists -->
    <If Condition="[Not Directory.Exists(in_Config(&quot;OutputFolderPath&quot;))]">
      <If.Then>
        <Assign DisplayName="Create Output Folder">
          <Assign.To><OutArgument x:TypeArguments="x:String">[strOutputPath]</OutArgument></Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:String">
              [(Function()
                Directory.CreateDirectory(in_Config("OutputFolderPath"))
                Return Path.Combine(in_Config("OutputFolderPath"), in_Config("OutputFileName"))
              End Function)()]
            </InArgument>
          </Assign.Value>
        </Assign>
      </If.Then>
    </If>

    <!-- STEP 2: Extract employee table data from browser.
         NOTE: Update the AttachBrowser selector and ExtractDataTable selector in Studio.
         Use the DataScraping wizard in Studio to configure ExtractDataTable properly. -->
    <uia:AttachBrowser DisplayName="Attach to ACME Browser"
                       Selector="&lt;html app='chrome.exe' title='ACME*' /&gt;">
      <uia:AttachBrowser.Body>
        <ActivityAction>
          <ui:RetryScope NumberOfRetries="[CInt(in_Config(&quot;MaxRetries&quot;))]"
                         RetryInterval="[New TimeSpan(0, 0, CInt(in_Config(&quot;RetryIntervalSeconds&quot;)))]"
                         DisplayName="Retry - Extract Employee Table">
            <ui:RetryScope.Body>
              <!-- ExtractDataTable extracts the full HTML table into a DataTable.
                   Configure the Selector to target the employee table element in Studio. -->
              <uia:ExtractDataTable DisplayName="Extract Employee Table Data"
                                    Selector="&lt;webctrl tag='TABLE' id='employee-table' /&gt;"
                                    DataTable="[dtEmployeeData]" />
            </ui:RetryScope.Body>
          </ui:RetryScope>
        </ActivityAction>
      </uia:AttachBrowser.Body>
    </uia:AttachBrowser>

    <ui:LogMessage Level="Info"
                   Message="[&quot;[PROCESS] Extracted &quot; &amp; If(dtEmployeeData IsNot Nothing, dtEmployeeData.Rows.Count.ToString(), &quot;0&quot;) &amp; &quot; employee records from table&quot;]" />

    <!-- Business exception if no rows extracted -->
    <If Condition="[dtEmployeeData Is Nothing OrElse dtEmployeeData.Rows.Count = 0]">
      <If.Then>
        <Throw>
          <Throw.Exception>
            <InArgument x:TypeArguments="uc:BusinessRuleException">
              [New UiPath.Core.BusinessRuleException("Employee table exists but contains no data rows.")]
            </InArgument>
          </Throw.Exception>
        </Throw>
      </If.Then>
    </If>

    <!-- STEP 3: Export to Excel -->
    <TryCatch DisplayName="Try - Export to Excel">
      <TryCatch.Try>
        <excel:ExcelApplicationScope WorkbookPath="[strOutputPath]"
                                      DisplayName="Write Employee Data to Excel"
                                      CreateNewFile="True"
                                      Password=""
                                      ReadOnly="False">
          <excel:ExcelApplicationScope.Body>
            <ActivityAction>
              <Sequence DisplayName="Write to Excel">
                <excel:WriteRange SheetName="EmployeeData"
                                  DisplayName="Write DataTable to Sheet"
                                  StartingCell="A1"
                                  DataTable="[dtEmployeeData]"
                                  AddHeaders="True" />

                <ui:LogMessage Level="Info"
                               Message="[&quot;[PROCESS] Excel export complete: &quot; &amp; strOutputPath]" />
              </Sequence>
            </ActivityAction>
          </excel:ExcelApplicationScope.Body>
        </excel:ExcelApplicationScope>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="sio:IOException">
          <ActivityAction x:TypeArguments="sio:IOException">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="sio:IOException" Name="ioEx" />
            </ActivityAction.Argument>
            <Sequence>
              <ui:LogMessage Level="Error"
                             Message="[&quot;[PROCESS] File access error writing Excel: &quot; &amp; ioEx.Message]" />
              <Throw Exception="[ioEx]" />
            </Sequence>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>

    <!-- Mark success -->
    <Assign DisplayName="Set Success = True">
      <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_Success]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
    </Assign>

    <ui:LogMessage Level="Info"
                   Message="[&quot;[PROCESS] Transaction &quot; &amp; in_TransactionID &amp; &quot; completed successfully.&quot;]" />
  </Sequence>
</Activity>
