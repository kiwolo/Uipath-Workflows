<?xml version="1.0" encoding="utf-8"?>
<Activity
  x:Class="Framework_GetTransactionData"
  mc:Ignorable="sap sap2010 sads"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:uia="http://schemas.uipath.com/workflow/activities/uiautomation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:Members>
    <x:Property Name="in_Config"            Type="InArgument(scg:Dictionary(x:String, x:String))" />
    <x:Property Name="in_TransactionNumber" Type="InArgument(x:Int32)" />
    <x:Property Name="out_MoreTransactions" Type="OutArgument(x:Boolean)" />
    <x:Property Name="out_TransactionID"    Type="OutArgument(x:String)" />
  </x:Members>

  <VisualBasic.Settings>
    <x:Null />
  </VisualBasic.Settings>

  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>

  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.UIAutomation.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>

  <Sequence DisplayName="GetTransactionData">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Boolean" Name="blnTableVisible" Default="False" />
      <Variable x:TypeArguments="x:Int32"   Name="intTimeout"      Default="30000" />
    </Sequence.Variables>

    <!-- For ACME, only one transaction (the full employee table download).
         If transaction number > 0 we are already done. -->
    <If Condition="[in_TransactionNumber > 0]" DisplayName="Already Processed?">
      <If.Then>
        <Sequence DisplayName="No More Transactions">
          <ui:LogMessage Level="Info"
                         Message="[&quot;[GET_DATA] All transactions completed. Total processed: &quot; &amp; in_TransactionNumber.ToString()]" />
          <Assign>
            <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_MoreTransactions]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value>
          </Assign>
          <Assign>
            <Assign.To><OutArgument x:TypeArguments="x:String">[out_TransactionID]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">[""]</InArgument></Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Navigate to Employees and Verify Table">
          <Assign DisplayName="Set timeout from Config">
            <Assign.To><OutArgument x:TypeArguments="x:Int32">[intTimeout]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:Int32">[CInt(in_Config("TimeoutMS"))]</InArgument></Assign.Value>
          </Assign>

          <!-- Attach to the already-open browser and click Employees menu.
               NOTE: Update the AttachBrowser selector to match your browser/title in Studio. -->
          <uia:AttachBrowser DisplayName="Attach to ACME Browser"
                             Selector="&lt;html app='chrome.exe' title='ACME*' /&gt;">
            <uia:AttachBrowser.Body>
              <ActivityAction>
                <Sequence DisplayName="Navigate and Check Table">
                  <!-- Click Employees menu -->
                  <uia:Click DisplayName="Click Employees Menu"
                             Selector="&lt;webctrl tag='A' innertext='Employees' /&gt;"
                             TimeoutMS="[intTimeout]" />

                  <!-- Verify employee table is present -->
                  <uia:ElementExists DisplayName="Check Employee Table Visible"
                                     Selector="&lt;webctrl tag='TABLE' id='employee-table' /&gt;"
                                     Exists="[blnTableVisible]"
                                     TimeoutMS="[intTimeout]" />
                </Sequence>
              </ActivityAction>
            </uia:AttachBrowser.Body>
          </uia:AttachBrowser>

          <If Condition="[blnTableVisible]">
            <If.Then>
              <Sequence>
                <ui:LogMessage Level="Info"
                               Message="[&quot;[GET_DATA] Employee table found. Scheduling extraction transaction.&quot;]" />
                <Assign>
                  <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_MoreTransactions]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
                </Assign>
                <Assign>
                  <Assign.To><OutArgument x:TypeArguments="x:String">[out_TransactionID]</OutArgument></Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">
                      ["ACME_EMPLOYEES_" &amp; DateTime.Now.ToString("yyyyMMddHHmmss")]
                    </InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
            </If.Then>
            <If.Else>
              <Sequence>
                <ui:LogMessage Level="Warn"
                               Message="[&quot;[GET_DATA] Employee table not visible on page. No transaction to process.&quot;]" />
                <Assign>
                  <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_MoreTransactions]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value>
                </Assign>
                <Assign>
                  <Assign.To><OutArgument x:TypeArguments="x:String">[out_TransactionID]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[""]</InArgument></Assign.Value>
                </Assign>
              </Sequence>
            </If.Else>
          </If>
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
</Activity>
