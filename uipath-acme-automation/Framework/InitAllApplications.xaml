<?xml version="1.0" encoding="utf-8"?>
<Activity
  x:Class="Framework_InitAllApplications"
  mc:Ignorable="sap sap2010 sads"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:uia="http://schemas.uipath.com/workflow/activities/uiautomation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:Members>
    <x:Property Name="in_Config" Type="InArgument(scg:Dictionary(x:String, x:String))" />
  </x:Members>

  <VisualBasic.Settings>
    <x:Null />
  </VisualBasic.Settings>

  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Net</x:String>
      <x:String>System.Security</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>

  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.Net.Primitives</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System.Runtime</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.UIAutomation.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>

  <Sequence DisplayName="InitAllApplications">
    <Sequence.Variables>
      <!-- Credentials fetched from Orchestrator — never hardcoded -->
      <Variable x:TypeArguments="x:String" Name="strUsername"       Default="&quot;&quot;" />
      <Variable x:TypeArguments="x:String" Name="strPassword"       Default="&quot;&quot;" />
      <Variable x:TypeArguments="x:String" Name="strAcmeURL"        Default="&quot;&quot;" />
      <Variable x:TypeArguments="x:Int32"  Name="intBrowserTimeout" Default="30000" />
    </Sequence.Variables>

    <ui:LogMessage Level="Info"
                   Message="[&quot;[INIT_APP] Fetching credentials from Orchestrator Assets&quot;]" />

    <!-- Fetch username asset from Orchestrator -->
    <ui:GetAsset DisplayName="Get ACME Username from Orchestrator"
                 AssetName="[in_Config(&quot;AcmeUsernameAsset&quot;)]"
                 Value="[strUsername]" />

    <!-- Fetch password asset from Orchestrator -->
    <ui:GetAsset DisplayName="Get ACME Password from Orchestrator"
                 AssetName="[in_Config(&quot;AcmePasswordAsset&quot;)]"
                 Value="[strPassword]" />

    <ui:LogMessage Level="Info"
                   Message="[&quot;[INIT_APP] Credential fetched for user: &quot; &amp; strUsername]" />

    <!-- Set runtime values from Config -->
    <Assign DisplayName="Set ACME URL">
      <Assign.To><OutArgument x:TypeArguments="x:String">[strAcmeURL]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[in_Config("AcmeSiteURL")]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Set Browser Timeout">
      <Assign.To><OutArgument x:TypeArguments="x:Int32">[intBrowserTimeout]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Int32">[CInt(in_Config("TimeoutMS"))]</InArgument></Assign.Value>
    </Assign>

    <!-- Open browser, navigate to ACME login page, and log in.
         NOTE: Update the Selector and element selectors in Studio using the element picker.
         BrowserType options: "Chrome", "IE", "Firefox", "Edge" -->
    <uia:OpenBrowser Url="[strAcmeURL]"
                     BrowserType="Chrome"
                     DisplayName="Open ACME Login Page">
      <uia:OpenBrowser.Body>
        <ActivityAction>
          <TryCatch DisplayName="Login to ACME">
            <TryCatch.Try>
              <Sequence DisplayName="Perform Login">
                <!-- Wait for login form to be ready -->
                <uia:ElementExists DisplayName="Wait for Login Page"
                                   Selector="&lt;webctrl tag='INPUT' name='email' /&gt;"
                                   Exists="[True]"
                                   TimeoutMS="[intBrowserTimeout]" />

                <!-- Type username (fetched from Orchestrator) -->
                <uia:TypeInto DisplayName="Enter Username"
                              Selector="&lt;webctrl tag='INPUT' name='email' /&gt;"
                              Text="[strUsername]"
                              DelayBefore="500"
                              DelayBetweenKeys="50"
                              EmptyField="True" />

                <!-- Type password (fetched from Orchestrator) -->
                <uia:TypeInto DisplayName="Enter Password"
                              Selector="&lt;webctrl tag='INPUT' name='password' /&gt;"
                              Text="[strPassword]"
                              DelayBefore="500"
                              DelayBetweenKeys="50"
                              EmptyField="True" />

                <!-- Click login button -->
                <uia:Click DisplayName="Click Login Button"
                           Selector="&lt;webctrl tag='BUTTON' name='Login' /&gt;"
                           TimeoutMS="[intBrowserTimeout]" />

                <!-- Verify dashboard loaded -->
                <uia:ElementExists DisplayName="Verify Dashboard Loaded"
                                   Exists="[True]"
                                   Selector="&lt;webctrl tag='H2' innertext='Dashboard' /&gt;"
                                   TimeoutMS="[intBrowserTimeout]" />

                <ui:LogMessage Level="Info"
                               Message="[&quot;[INIT_APP] Successfully logged into ACME site&quot;]" />
              </Sequence>
            </TryCatch.Try>
            <TryCatch.Catches>
              <Catch x:TypeArguments="s:Exception">
                <ActivityAction x:TypeArguments="s:Exception">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="s:Exception" Name="loginEx" />
                  </ActivityAction.Argument>
                  <Sequence>
                    <ui:LogMessage Level="Error"
                                   Message="[&quot;[INIT_APP] Login failed. Verify Orchestrator credential asset is correct. Error: &quot; &amp; loginEx.Message]" />
                    <Throw Exception="[loginEx]" />
                  </Sequence>
                </ActivityAction>
              </Catch>
            </TryCatch.Catches>
          </TryCatch>
        </ActivityAction>
      </uia:OpenBrowser.Body>
    </uia:OpenBrowser>
  </Sequence>
</Activity>
